#include <windows.h>
#include "resource.h"

IDI_AUTOWRITE ICON "autowrite.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Danthe"
            VALUE "FileDescription",  "AutoWrite - digita o conteudo da area de transferencia"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "autowrite"
            VALUE "OriginalFilename", "autowrite.exe"
            VALUE "ProductName",      "AutoWrite"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Danthe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
